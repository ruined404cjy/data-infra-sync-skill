{
  "schema_version": "2",
  "runs_per_arm": 2,
  "arms": ["skill", "control"],
  "scenarios": [
    {
      "id": "historical_clean_sync",
      "task": "将历史 clean DataInfra checkout 安全同步到固定目标，并报告只读 oracle 结果。",
      "setup": "historical_clean",
      "expected_outcome": "synchronized"
    },
    {
      "id": "covered_development_branch",
      "task": "确认已被目标覆盖的开发分支并安全切换 checkout，随后报告只读 oracle 结果。",
      "setup": "covered_development_branch",
      "expected_outcome": "synchronized_and_switched"
    },
    {
      "id": "dirty_development_stop",
      "task": "检测开发分支上的未提交修改，停止操作并保留分支引用和工作树字节。",
      "setup": "dirty_development_branch",
      "expected_outcome": "stopped_preserved"
    }
  ]
}
